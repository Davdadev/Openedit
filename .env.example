# OpenEdit stock-media API keys (all free). Copy to ~/.openedit/.env or run `openedit keys`.
# Openverse, Wikimedia Commons and NASA need no key.
PEXELS_API_KEY=        # https://www.pexels.com/api/new/
PIXABAY_API_KEY=       # https://pixabay.com/api/docs/
UNSPLASH_ACCESS_KEY=   # https://unsplash.com/oauth/applications
FREESOUND_API_KEY=     # https://freesound.org/apiv2/apply/
JAMENDO_CLIENT_ID=     # https://devportal.jamendo.com/
# Optional: where downloads go (default ~/OpenEdit Media)
# OPENEDIT_MEDIA_DIR=
