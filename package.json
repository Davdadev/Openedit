{
  "name": "openedit",
  "version": "0.1.0",
  "description": "Open-source, local, subscription-free AI video editing toolkit driven by Claude over MCP. Works in Premiere Pro, DaVinci Resolve, or standalone with ffmpeg.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openedit": "dist/cli.js"
  },
  "main": "dist/mcp/server.js",
  "files": [
    "dist",
    "premiere",
    "resolve",
    "templates",
    "docs",
    "src/studio/web",
    "src/ui/views"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "test:motion": "tsx src/motion/test/render-smoke.ts",
    "test:studio": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "hyperframes": "0.9.59"
  }
}
